@article{LiB,
  title    = {Persistent active target protection with multiple nonlinear players in arbitrary space dimensions},
  journal  = {Aerospace Science and Technology},
  volume   = {171},
  pages    = {111599},
  year     = {2026},
  issn     = {1270-9638},
  doi      = {https://doi.org/10.1016/j.ast.2025.111599},
  url      = {https://www.sciencedirect.com/science/article/pii/S1270963825016633},
  author   = {Bochen Li and Chenggang Wang and Dan Huang and Lei Song and Chenguang Yang and Huaping Liu},
  keywords = {Active target defense, Differential games, Nonlinear dynamics, Control barrier functions},
  abstract = {This paper presents an active target protection approach that accommodates multiple defenders and attackers with nonlinear dynamics operating in arbitrary space dimensions. To establish a formal connection between the defense-winning conditions and the control inputs of nonlinear players, the m-sphere pursuit enclosure function (mSPEF) is proposed. The mSPEFs enable the explicit construction of control barrier functions (CBFs), which are further composed to form the forward invariant condition. This formulation allows the multi-player defense-winning condition to be transformed into linear constraints on the control inputs of the defenders and the target. A CBF-based quadratic programming (CBF-QP) controller is developed, ensuring real-time applicability with the defense-winning guarantee. Two implementing examples in both two-dimensional and three-dimensional scenarios are provided with specific controller parameters. Experiments conducted on real-world robots validate the effectiveness and practicality of the proposed approach.}
}

