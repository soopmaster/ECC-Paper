@article{immrax,
  title    = {immrax: A Parallelizable and Differentiable Toolbox for Interval Analysis and Mixed Monotone Reachability in JAX},
  journal  = {IFAC-PapersOnLine},
  volume   = {58},
  number   = {11},
  pages    = {75-80},
